        value: "10.5281/zenodo.22848154"
        description: "Concept DOI for the evolving BPFCompat research dataset across versions."
      - type: url
        value: "https://github.com/Kernel-Guard/bpfcompat/releases/tag/research-v1"
        description: "GitHub research-v1 release archived by this dataset."
    version: "research-v1"
    date-released: "2026-09-19"
    url: "https://zenodo.org/records/22848155"
